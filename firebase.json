{
  "functions": [
    {
      "source": "functions",
      "codebase": "whatsapp-billing",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "*.local"
      ]
    },
    {
      "source": "datajud-functions",
      "codebase": "datajud",
      "runtime": "nodejs22",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "*.local",
        "*.test.js"
      ]
    }
  ],
  "firestore": [
    {
      "database": "whatsapp-automation",
      "rules": "deployment/firestore.rules"
    }
  ],
  "hosting": {
    "site": "rodrigues-amr",
    "public": ".hosting-public",
    "ignore": [
      ".*"
    ],
    "headers": [
      {
        "source": "/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
